# ==============================================================================
# OsterdOps — Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Client-Side Firebase Configuration (Publicly accessible in browser bundle)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="osterdops.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="osterdops"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="osterdops.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef"

# ------------------------------------------------------------------------------
# 2. Server-Side Firebase Admin Configuration (STRICTLY PRIVATE - Never in browser)
# Option A: Individual credentials
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID="osterdops"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk@osterdops.iam.gserviceaccount.com"
# Note: In .env files, private keys with newlines should use literal "\n" or be enclosed in quotes
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B: Single Service Account JSON or Base64 String (Alternative to Option A)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"osterdops",...}'

# ------------------------------------------------------------------------------
# 3. OsterdOps Security & Encryption
# Used to encrypt/decrypt upstream AI provider keys stored in Firestore
# Must be a 32-byte hex or base64 string (e.g. `openssl rand -hex 32`)
# ------------------------------------------------------------------------------
OSTERDOPS_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# 4. Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 5. Developer Experience & TypeScript SDK Configuration
# ------------------------------------------------------------------------------
# Default project API key used by @osterdops/sdk and CLI tools
OSTERDOPS_API_KEY="osk_live_••••••••••••••••••••••••"

# Base URL for OsterdOps API requests (default: https://api.osterdops.com)
OSTERDOPS_BASE_URL="http://localhost:3000"

# AI Gateway server request timeout deadline (in milliseconds, default: 60000)
GATEWAY_REQUEST_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# 6. OsterdOps C++ Gateway Engine
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GATEWAY_URL="http://localhost:8080/api/v1/chat/completions"
