# ==============================================================================
# OsterdOps — Production Environment Variables Configuration Template
# ==============================================================================
# For Vercel, Railway, AWS ECS, or Self-Hosted VPC deployments.
# IMPORTANT: DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL.
# Set these variables in your Vercel Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Production Application & Domain Settings
# ------------------------------------------------------------------------------
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://app.osterdops.com"
OSTERDOPS_BASE_URL="https://gateway.osterdops.com"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# AI Gateway Server Timeout (ms, default: 60000)
GATEWAY_REQUEST_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# 2. Client-Side Firebase Configuration (Publicly accessible in browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyAZMDMsBZC5IltAVVnFdcdyyYQ-1TOdvSw"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="osterdops.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="osterdops"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="osterdops.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="105623223533"
NEXT_PUBLIC_FIREBASE_APP_ID="1:105623223533:web:16b1ef8f75256b71f120e4"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-8X7W89BGCZ"

# ------------------------------------------------------------------------------
# 3. Server-Side Firebase Admin SDK (STRICTLY CONFIDENTIAL - Never exposed to client)
# ------------------------------------------------------------------------------
# Option A: Individual credentials (recommended for Vercel env UI)
FIREBASE_ADMIN_PROJECT_ID="osterdops"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@osterdops.iam.gserviceaccount.com"
# Note: Keep literal \n in private key string for single-line env variable format
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B: Full JSON String (Alternative to Option A)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"osterdops","private_key_id":"...","private_key":"...","client_email":"..."}'

# ------------------------------------------------------------------------------
# 4. Master Data Vault & Credential Encryption (AES-256-GCM)
# ------------------------------------------------------------------------------
# Used to encrypt and decrypt customer upstream API keys at rest in Firestore.
# Must be a 32-byte hex string (64 characters) generated via: `openssl rand -hex 32`
OSTERDOPS_ENCRYPTION_KEY="replace_with_64_char_hex_generated_via_openssl_rand_hex_32"

# ------------------------------------------------------------------------------
# 5. Distributed Rate Limiting & High-Throughput Redis (Upstash / Redis)
# ------------------------------------------------------------------------------
# Set to 'redis' in production for distributed sliding-window rate limiting.
# Falls back safely to high-performance in-memory if omitted or during Redis maintenance.
OSTERDOPS_RATE_LIMIT_PROVIDER="redis"
REDIS_URL="rediss://default:xxxxxxxx@xxxx.upstash.io:6379"

# Stripe Live Mode API Keys
STRIPE_SECRET_KEY="replace_with_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="replace_with_your_stripe_webhook_signing_secret"

# ------------------------------------------------------------------------------
# 7. (Optional) Enterprise Upstream Provider Fallbacks
# ------------------------------------------------------------------------------
# Allows the platform to provide gateway fallback routing even if customer has no BYOM key
# OPENAI_API_KEY="your_openai_api_key"
# ANTHROPIC_API_KEY="your_anthropic_api_key"
# GEMINI_API_KEY="AIzaSy..."
# GROQ_API_KEY="gsk_..."
# PERPLEXITY_API_KEY="pplx-..."
# MISTRAL_API_KEY="mis_..."
# COHERE_API_KEY="..."
