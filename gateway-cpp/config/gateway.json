{
  "service": "osterdops-gateway-cpp",
  "version": "1.0.0",
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "worker_threads": 8,
    "timeout_ms": 60000
  },
  "governance": {
    "rate_limiting": {
      "default_requests_per_minute": 120,
      "window_ms": 60000
    },
    "default_budget": {
      "limit_usd": 50.0,
      "enforcement": "HARD",
      "warning_thresholds": [0.50, 0.75, 0.90, 1.00]
    }
  },
  "providers": {
    "openai": {
      "base_url": "https://api.openai.com/v1",
      "timeout_ms": 60000,
      "max_retries": 3,
      "api_key_env": "OPENAI_API_KEY"
    },
    "anthropic": {
      "base_url": "https://api.anthropic.com/v1",
      "timeout_ms": 60000,
      "max_retries": 3,
      "api_key_env": "ANTHROPIC_API_KEY"
    },
    "deepseek": {
      "base_url": "https://api.deepseek.com/v1",
      "timeout_ms": 60000,
      "max_retries": 3,
      "api_key_env": "DEEPSEEK_API_KEY",
      "circuit_breaker": {
        "failure_threshold": 3,
        "recovery_timeout_ms": 30000
      }
    },
    "gemini": {
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "timeout_ms": 60000,
      "max_retries": 3,
      "api_key_env": "GEMINI_API_KEY"
    },
    "ollama": {
      "base_url": "http://localhost:11434/v1",
      "timeout_ms": 60000,
      "max_retries": 2
    }
  },
  "authentication": {
    "allowed_keys": [
      "osterdops_live_demo_key",
      "sk-osterdops-default"
    ]
  },
  "notes": {
    "provider_credentials": "Upstream API keys are resolved from environment variables: OPENAI_API_KEY, DEEPSEEK_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY"
  }
}
